{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.js",
    "src/tokens.js",
    "src/components/ChoiceChips.jsx",
    "src/components/DemoButton.jsx",
    "src/components/StatusCard.jsx"
  ],
  "exclude": ["src/**/*.stories.jsx", "src/__tests__", "node_modules"]
}
